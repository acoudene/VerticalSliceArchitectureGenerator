@page "/entityName/{Id?}"
@using Feature.RazorComponents

<PageTitle>EntityName</PageTitle>

<MudCard>
  <EntityNameForm @ref="@_form" ViewObject="@ViewModel.SelectedItem" />
  <MudCardActions>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="ml-auto" OnClick="@(async () => await ValidateSubmitAsync())">@Localizer["Submit"]</MudButton>
  </MudCardActions>
</MudCard>