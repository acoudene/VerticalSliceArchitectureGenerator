@inherits MudForm

<ReliableContent>
  <div class="EntityNameForm-container">
    <MudForm Model="@ViewObject" Validation="@(_entityNameValidator.ValidateValue)" ValidationDelay="0">
      <MudCardContent>

        <MudTextField @bind-Value="ViewObject.Id"
                      For="@(() => ViewObject.Id)"
                      ReadOnly="true"
                      Immediate="true"
                      Label="@Localizer["Id"]" />

        @* These 2 lines below use DateChanged whereas it is readonly mode to illustrate by example.
          The readonly mode is used due to aggressive update of these dates during repository writting. *@

        <MudDatePicker Date="ViewObject.CreatedAt"
                       DateChanged="(newDate)=>ViewObject.CreatedAt=newDate!.Value"
                       ReadOnly="true"
                       Label="@Localizer["CreatedAt"]" />

        <MudDatePicker Date="ViewObject.UpdatedAt"
                       DateChanged="(newDate)=>ViewObject.UpdatedAt=newDate!.Value"
                       ReadOnly="true"
                       Label="@Localizer["UpdatedAt"]" />

        @* // TODO - Complete with other fields *@

      </MudCardContent>

      @* // TODO - Complete with other sub items fields *@
      @* <MudCardContent Class="pa-0">

      <MudTable Items="@Vo.SubItems" Hover="true" Breakpoint="Breakpoint.None" Dense="@true" Elevation="0">
      <HeaderContent>


      </HeaderContent>
      <RowTemplate>


      </RowTemplate>
      </MudTable>

      </MudCardContent> *@
    </MudForm>
  </div>
</ReliableContent>
@{
  base.BuildRenderTree(__builder);
}